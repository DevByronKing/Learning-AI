# ==============================================================================
# LEARNING AI - VARIÁVEIS DE AMBIENTE DE PRODUÇÃO (.env.example)
# ==============================================================================

# 1. Supabase (Banco de Dados PostgreSQL, Auth e Storage)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada (apenas para backend)

# 2. Google Gemini AI (Diagnóstico Cognitivo, Edital e Discursivas)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-1.5-flash

# 3. URLs da Aplicação
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br

# 4. Segurança Administrativa (Ingestão de Provas e Leads)
# Chave secreta de alta entropia para rotas /api/admin
ADMIN_API_KEY=gere-um-segredo-forte-aqui-ex-64-caracteres

# 5. Gateway de Pagamento (Asaas Pix / Boleto / Cartão)
PAYMENT_GATEWAY_PROVIDER=asaas # 'asaas', 'stripe' ou 'mock'
ASAAS_API_KEY=$aact_sua_chave_asaas_aqui
ASAAS_ENVIRONMENT=sandbox # use 'production' quando ativar sua conta Asaas
ASAAS_WEBHOOK_SECRET=token-secreto-configurado-no-painel-asaas

# 6. Gateway Stripe (Opcional - Cartão Internacional)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 7. E-mail Transacional de Boas-Vindas (Resend - 3.000 emails/mês grátis)
# Obtenha em: https://resend.com
RESEND_API_KEY=re_sua_chave_resend_aqui

# 8. Rastreamento e Analytics (Opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=1234567890

