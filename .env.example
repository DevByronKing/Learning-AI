# ==============================================================================
# APROVALENS AI - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# Supabase (PostgreSQL, Auth, Storage e Realtime)
# Obtenha estas chaves em: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada (apenas para backend)

# OpenAI / Modelos de IA (Opcional - Usado nos endpoints /api/diagnosis e /api/edital)
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui
OPENAI_MODEL=gpt-4o-mini

# URLs da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gateway de Pagamentos (Pix / Cartão - Asaas ou Stripe)
PAYMENT_GATEWAY_PROVIDER=mock # 'asaas', 'stripe' ou 'mock'
ASAAS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
