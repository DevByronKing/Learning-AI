# ==============================================================================
# LEARNING AI - VARIÁVEIS DE AMBIENTE ESSENCIAIS (.env.example)
# ==============================================================================

# 1. URL da Aplicação
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br

# 2. Supabase (Banco de Dados PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# 3. Google Gemini (Motor de Inteligência Artificial)
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-1.5-flash

# 4. Gateway de Pagamento Asaas (Pix Instantâneo)
PAYMENT_GATEWAY_PROVIDER=asaas
ASAAS_API_KEY=$aact_sua_chave_asaas_aqui
ASAAS_ENVIRONMENT=production
ASAAS_WEBHOOK_SECRET=token-secreto-configurado-no-painel-asaas

# 5. E-mail Transacional de Boas-Vindas (Resend)
RESEND_API_KEY=re_sua_chave_resend_aqui

# 6. Chave Secreta Administrativa (Rotas /api/admin)
ADMIN_API_KEY=gere-um-segredo-forte-aqui


