{
  "name": "learning-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "build": "next build",
    "build:web": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:mobile": "npm --prefix apps/mobile start",
    "dev:mobile:clear": "npm --prefix apps/mobile start -- -c",
    "dev:mobile:tunnel": "npm --prefix apps/mobile run tunnel",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "install:mobile": "npm --prefix apps/mobile install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
